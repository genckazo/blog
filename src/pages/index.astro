---
import { DOOR_VARIANTS, DOOR_ORDER } from '../data/doors';

const base = import.meta.env.BASE_URL;
const variants = DOOR_ORDER.map((name) => ({ name, art: DOOR_VARIANTS[name] }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>genckazo — through the wardrobe</title>
    <meta name="description" content="genckazo's personal blog. Click the wardrobe doors to step inside." />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <style>
      :root {
        --bg: #171512;
        --ink: #e8e3d6;
        --dim: #8d8676;
        --paper: #f2eee1;
        --paper-ink: #2a271f;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        min-height: 100svh;
        background:
          radial-gradient(120% 90% at 50% 8%, #211e19 0%, var(--bg) 55%, #100f0d 100%);
        color: var(--ink);
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
        display: flex;
      }
      .scene {
        margin: auto;
        padding: 2.2rem 1rem 2.6rem;
        text-align: center;
        max-width: 100%;
      }
      .over {
        margin: 0 0 1.3rem;
        font-size: 0.72rem;
        letter-spacing: 0.42em;
        text-transform: uppercase;
        color: var(--dim);
      }
      /* The wardrobe: fixed frame, two sliding leaves. Width is 80ch so the
         whole drawing scales with font-size. */
      .stage {
        font-size: clamp(3px, 1.8vw, 15px);
        line-height: 1.05;
        width: fit-content;
        margin: 0 auto;
        overflow: hidden;
        cursor: pointer;
        perspective: 1100px;
        border-radius: 2px;
      }
      .stage[hidden] { display: none; }
      .stage:focus-visible { outline: 1px dashed var(--dim); outline-offset: 8px; }
      .stage pre {
        margin: 0;
        font-family: inherit;
        font-size: 1em;
        line-height: inherit;
        color: var(--ink);
        user-select: none;
        white-space: pre;
      }
      .leaf {
        position: absolute;
        top: 0;
        display: block;
        overflow: hidden;
        transition: transform 1.05s cubic-bezier(0.65, 0.05, 0.25, 1), opacity 1.05s ease;
        will-change: transform;
      }
      .leaf-l { left: 2ch; width: 35ch; }
      .leaf-r { left: 42ch; width: 35ch; }
      .leaf-r pre { margin-left: -42ch; }
      .stage.open .leaf-l { transform: translateX(-41ch) rotateY(-16deg); opacity: 0.12; }
      .stage.open .leaf-r { transform: translateX(41ch) rotateY(16deg); opacity: 0.12; }
      .behind {
        position: absolute;
        inset: 0;
        z-index: -1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.9rem;
        background:
          radial-gradient(90% 80% at 50% 45%, #f7f3e7 0%, var(--paper) 60%, #e6dfcb 100%);
        color: var(--paper-ink);
        font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
        opacity: 0;
        transition: opacity 0.9s ease 0.35s;
        padding: 1rem;
      }
      .stage.open .behind { opacity: 1; }
      .behind-line { margin: 0; font-size: clamp(0.7rem, 1.6vw, 1.05rem); font-style: italic; }
      .behind-link {
        color: var(--paper-ink);
        font-size: clamp(0.75rem, 1.8vw, 1.1rem);
        text-underline-offset: 4px;
      }
      .caption {
        margin: 1.5rem 0 0;
        font-size: 0.8rem;
        color: var(--dim);
      }
      .caption a { color: var(--ink); text-underline-offset: 3px; }
      .hint { animation: breathe 2.8s ease-in-out infinite; }
      @keyframes breathe { 50% { opacity: 0.4; } }
      .variant-row {
        margin: 0.9rem 0 0;
        font-size: 0.68rem;
        color: #5c564b;
        letter-spacing: 0.06em;
      }
      .variant-row a { color: var(--dim); text-underline-offset: 3px; }
      .variant-row a[aria-current="true"] { color: var(--ink); }
      @media (prefers-reduced-motion: reduce) {
        .leaf, .behind { transition-duration: 0.01s; }
        .hint { animation: none; }
      }
    </style>
  </head>
  <body>
    <main class="scene">
      <p class="over">genckazo&rsquo;s blog</p>

      {variants.map(({ name, art }, i) => (
        <div
          class="stage"
          id={`stage-${name}`}
          data-variant={name}
          role="button"
          tabindex="0"
          aria-label="Open the wardrobe doors and enter the blog"
          hidden={i !== 0}
        >
          <div class="behind" aria-hidden="true">
            <p class="behind-line">the wardrobe opens onto a quiet reading room</p>
            <a class="behind-link" href={`${base}posts/`} tabindex="-1">enter the blog &rarr;</a>
          </div>
          <pre class="layer frame">{art.frame}</pre>
          <span class="leaf leaf-l"><pre>{art.left}</pre></span>
          <span class="leaf leaf-r"><pre>{art.right}</pre></span>
        </div>
      ))}

      <p class="caption">
        <span class="hint">click the doors to step through</span>
        &nbsp;&middot;&nbsp;
        <a href={`${base}posts/`}>or go straight in &rarr;</a>
      </p>
      <p class="variant-row">
        door style:
        {variants.map(({ name }, i) => (
          <>{i > 0 && ' · '}<a href={`?door=${name}`} data-variant-link={name} aria-current={i === 0 ? 'true' : undefined}>{name}</a></>
        ))}
      </p>
    </main>

    <script>
      const base = import.meta.env.BASE_URL;
      const params = new URLSearchParams(window.location.search);
      const pick = params.get('door') ?? 'panel';

      const stages = Array.from(document.querySelectorAll<HTMLElement>('.stage'));
      for (const s of stages) s.hidden = s.dataset.variant !== pick;
      document.querySelectorAll<HTMLAnchorElement>('[data-variant-link]').forEach((a) => {
        a.setAttribute('aria-current', a.dataset.variantLink === pick ? 'true' : 'false');
      });

      let entered = false;
      function enter(stage: HTMLElement) {
        if (entered || stage.classList.contains('open')) return;
        entered = true;
        stage.classList.add('open');
        window.setTimeout(() => {
          window.location.href = `${base}posts/`;
        }, 1200);
      }

      for (const s of stages) {
        s.addEventListener('click', () => enter(s));
        s.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            enter(s);
          }
        });
      }
    </script>
  </body>
</html>
