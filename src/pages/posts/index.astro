---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const base = import.meta.env.BASE_URL;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout title="Blog — genckazo" current="blog">
  <h1 class="page-title">Reading list</h1>

  {posts.length === 0 ? (
    <p class="lede">No posts yet.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <svg class="post-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
          </svg>
          <div class="post-body">
            <h2><a href={`${base}posts/${post.id}/`}>{post.data.title}</a></h2>
            {post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
          </div>
          <span class="post-date">{fmt(post.data.date)}</span>
        </li>
      ))}
    </ul>
  )}
</Layout>
